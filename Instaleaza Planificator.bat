@echo off
title Instalare Planificator Proiecte
powershell -NoProfile -ExecutionPolicy Bypass -Command "$s=[IO.File]::ReadAllText('%~f0'); iex $s.Substring($s.LastIndexOf('#'+'PSSTART'))"
goto :eof
#PSSTART
$ErrorActionPreference = 'Stop'
$url  = 'https://claude.ai/artifact/DJyAtkeNjuJaPtDTwd28rm'
$name = 'Planificator Proiecte'
$dir  = Join-Path $env:LOCALAPPDATA 'PlanificatorBrisk'
$prof = Join-Path $dir 'profil'
New-Item -ItemType Directory -Force -Path $prof | Out-Null
$ico = Join-Path $dir 'planificator.ico'
[IO.File]::WriteAllBytes($ico, [Convert]::FromBase64String(''))

# browser: Microsoft Edge (exista pe orice Windows), altfel Google Chrome
$cands = @(
  (Join-Path ${env:ProgramFiles(x86)} 'Microsoft\Edge\Application\msedge.exe'),
  (Join-Path $env:ProgramFiles 'Microsoft\Edge\Application\msedge.exe'),
  (Join-Path $env:ProgramFiles 'Google\Chrome\Application\chrome.exe'),
  (Join-Path ${env:ProgramFiles(x86)} 'Google\Chrome\Application\chrome.exe'),
  (Join-Path $env:LOCALAPPDATA 'Google\Chrome\Application\chrome.exe'))
$exe = $cands | Where-Object { $_ -and (Test-Path $_) } | Select-Object -First 1
if (-not $exe) { Write-Host 'Nu am gasit Microsoft Edge sau Google Chrome.' -ForegroundColor Red; Read-Host 'Enter'; exit 1 }
$appArgs = "--app=$url --user-data-dir=`"$prof`" --no-first-run --no-default-browser-check --window-size=1440,920"

# scurtaturi: Desktop + meniul Start
$sh = New-Object -ComObject WScript.Shell
$targets = @(
  (Join-Path ([Environment]::GetFolderPath('Desktop')) "$name.lnk"),
  (Join-Path ([Environment]::GetFolderPath('Programs')) "$name.lnk"))
foreach ($t in $targets) {
  $l = $sh.CreateShortcut($t)
  $l.TargetPath = $exe; $l.Arguments = $appArgs; $l.IconLocation = "$ico,0"
  $l.Description = 'Planificator proiecte - Brisk'; $l.WorkingDirectory = $dir
  $l.Save()
}

# protocol planificator: (folosit de butonul din notificarile Windows)
$k = 'HKCU:\Software\Classes\planificator'
New-Item -Path "$k\shell\open\command" -Force | Out-Null
Set-ItemProperty -Path $k -Name '(default)' -Value 'URL:Planificator Proiecte'
Set-ItemProperty -Path $k -Name 'URL Protocol' -Value ''
New-Item -Path "$k\DefaultIcon" -Force | Out-Null
Set-ItemProperty -Path "$k\DefaultIcon" -Name '(default)' -Value "$ico,0"
Set-ItemProperty -Path "$k\shell\open\command" -Name '(default)' -Value "`"$exe`" $appArgs"

# daca notificarile sunt instalate, butonul lor deschide de acum aplicatia
$n = Join-Path $env:LOCALAPPDATA 'PlanificatorNotificari\notificare.ps1'
if (Test-Path $n) {
  $c = [IO.File]::ReadAllText($n)
  $c = $c -replace '\$url = "https://claude\.ai/artifact/[^"]+"', '$url = "planificator:open"'
  [IO.File]::WriteAllText($n, $c, (New-Object Text.UTF8Encoding($true)))
}

Write-Host ''
Write-Host 'Gata! Planificatorul este instalat ca aplicatie.' -ForegroundColor Green
Write-Host " - pictograma '$name' pe Desktop si in meniul Start"
Write-Host ' - se deschide in fereastra proprie, fara bara de adrese'
Write-Host ''
Write-Host 'PRIMA DATA: autentifica-te in fereastra aplicatiei cu contul licente@briskgrp.com.' -ForegroundColor Yellow
Write-Host 'Aplicatia isi pastreaza separat autentificarea, deci nu se amesteca cu alte conturi din browser.'
Write-Host 'Pentru bara de activitati: clic dreapta pe pictograma aplicatiei deschise > Fixare in bara de activitati.'
Write-Host ''
Start-Process -FilePath $exe -ArgumentList $appArgs
Read-Host 'Apasa Enter ca sa inchizi'
